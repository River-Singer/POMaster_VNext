      "VehicleModelUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "businessCode": {
            "type": "string",
            "maxLength": 32,
            "title": "车型编码"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "title": "名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ],
            "x-enum-labels": {
              "ENABLED": "启用",
              "DISABLED": "停用"
            },
            "title": "状态"
          },
          "seats": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 1,
            "maximum": 99,
            "title": "座位数"
          },
          "listPrice": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$",
            "x-minimum": "0",
            "title": "指导价"
          },
          "costPrice": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$",
            "x-minimum": "0",
            "title": "成本价"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "title": "说明"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "读到的版本号原样带回"
          }
        },
        "required": [
          "businessCode",
          "name",
          "status",
          "version"
        ]
