          },
          "listPrice": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$",
            "x-minimum": "0",
            "title": "指导价"
          },
          "costPrice": {
            "type": [
              "string",
