          "proves_zh": "构建通过、应用能起来、主路径走得通——更深的测试之前先过这一关。",
          "evidence": [
            "build",
            "browser-e2e"
          ]
        },
        {
          "id": "unit-integration",
          "title_zh": "单元、组件与集成测试",
          "proves_zh": "单个函数、组件与模块组合按约定工作。",
          "evidence": [
            "unit-component-integration"
          ]
        },
        {
          "id": "regression",
          "title_zh": "回归测试",
          "proves_zh": "改动之后，原有行为与界面没有被改坏。",
          "evidence": [
            "unit-component-integration",
            "browser-e2e",
            "visual-regression"
          ]
        },
        {
          "id": "white-box",
          "title_zh": "白盒测试",
          "proves_zh": "看着代码测：覆盖率、复杂度（CRAP）、变异测试、死代码与重复、类型与静态检查、架构约定。",
          "evidence": [
            "coverage",
            "complexity-crap",
            "mutation",
            "dead-code-duplicate",
            "typecheck-lint",
            "architecture"
          ],
          "rules": [
            {
              "key": "discipline",
              "title_zh": "写测试的纪律",
              "statement_zh": "改代码前先写一个会失败的测试，看它因预期的原因失败，再做让它通过的最小改动；测试按使用者的方式调用、检查使用者看得到的结果——所有函数都返回空时仍能通过的测试要删掉；单个函数的 CRAP 超过项目质量基线里的阈值就拆分或补测；变异测试里存活的变异用新测试杀掉，覆盖不到的死代码删掉。",
              "rationale_zh": "覆盖率、CRAP 与变异分数只在测试真正测行为时才有意义；先失败再通过，才能证明测试确实在测。",
              "scope_zh": "所有空间的代码与测试",
              "check_zh": "评审时看测试是否先于实现失败过；CRAP 与变异结果按证据规范入账，没跑的记 NOT_RUN"
            }
          ]
        },
        {
          "id": "black-box",
          "title_zh": "黑盒测试",
          "proves_zh": "只看外部行为：端到端、接口契约、业务验收、视觉、可访问性。",
