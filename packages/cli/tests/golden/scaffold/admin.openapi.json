  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 问题详情（ARCHETYPE.API.ERROR）：五个标准成员 + 扩展成员；客户端必须忽略不认识的扩展成员",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "description": "必须与真实 HTTP 状态码一致"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "description": "扩展成员：业务错误码"
          },
          "trace_id": {
            "type": "string",
            "description": "扩展成员：链路追踪 id"
          },
          "field_errors": {
            "type": "array",
            "description": "扩展成员：字段级错误",
            "items": {
              "type": "object",
              "required": [
                "detail",
                "pointer"
              ],
              "properties": {
                "detail": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string",
                  "description": "JSON Pointer，指向出错字段"
                }
              }
            }
          }
        },
        "required": [
          "title",
          "status"
        ]
      },
      "VehicleModel": {
        "type": "object",
        "title": "车型",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "businessCode": {
            "type": "string",
            "maxLength": 32,
            "title": "车型编码"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "title": "名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ],
            "x-enum-labels": {
              "ENABLED": "启用",
              "DISABLED": "停用"
            },
            "title": "状态"
          },
          "seats": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 1,
            "maximum": 99,
            "title": "座位数"
          },
          "listPrice": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$",
            "x-minimum": "0",
            "title": "指导价"
          },
          "costPrice": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$",
            "x-minimum": "0",
            "title": "成本价"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "title": "说明"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "createdBy": {
            "type": "string",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedBy": {
            "type": "string",
            "readOnly": true
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "乐观锁版本：修改 / 删除时原样带回，不一致返回 409"
          }
        },
        "required": [
          "id",
          "businessCode",
          "name",
          "status",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "version"
        ]
      },
      "VehicleModelPage": {
        "type": "object",
        "properties": {
          "items": {
