              "template": null,
              "jsx": "<div className=\"flex w-72 items-center gap-2 rounded-md border border-border p-3\">\n  <div className=\"min-w-0 flex-1 truncate text-label-14\">pomaster-web-git-feature-design-standard-team.vercel.app</div>\n  <Badge variant=\"secondary\">Preview</Badge>\n</div>",
              "code": null,
              "lang": null
            }
          ],
          "storybook": {
            "id": "standard-foundations-layout--layout-reflow",
            "url": "?path=/story/standard-foundations-layout--layout-reflow"
          }
        }
      ]
