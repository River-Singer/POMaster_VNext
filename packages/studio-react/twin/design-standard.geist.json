      "key": "motion",
      "title_zh": "动效",
      "group": "foundations",
      "group_title_zh": "基础",
      "prefix": "MOTION",
      "summary_zh": "默认静止；动效只用来解释状态变化、保持连续、确认操作；尊重减少动效设置。",
      "storybook": {
        "title": "规范/基础/动效",
        "id": "standard-foundations-motion--overview",
        "url": "?path=/story/standard-foundations-motion--overview"
      },
      "rules": [
        {
          "id": "MOTION.PURPOSE",
          "title_zh": "默认静止，动效要有理由",
          "statement_zh": "界面默认静止。动效只用于三件事：解释状态变化、保持视觉连续、确认一个操作。不用跑马灯、打字光标、脉冲指示、弹跳、视差和滚动出现效果；用户开启「减少动效」时关闭或降级。",
          "rationale_zh": null,
          "surfaces": [
            "admin",
            "public"
          ],
          "enforcement": {
            "kind": "review"
          },
          "params": [],
          "anchors": [
            {
              "spec": "ui",
              "doc": "themes/ui-presentation-and-design.md",
              "quote": "尊重 prefers-reduced-motion：动画、滚动、过渡在减少动效模式下关闭或降级"
            }
          ],
          "examples": [],
          "storybook": {
            "id": "standard-foundations-motion--motion-purpose",
            "url": "?path=/story/standard-foundations-motion--motion-purpose"
          }
        }
      ]
    },
    {
      "key": "layout",
      "title_zh": "布局与可访问性",
      "group": "foundations",
      "group_title_zh": "基础",
      "prefix": "LAYOUT",
      "summary_zh": "一个 h1、标题有序；先换行再缩小；网格与弹性子项设 min-width 0；不藏溢出；源码顺序即阅读顺序。",
      "storybook": {
        "title": "规范/基础/布局与可访问性",
        "id": "standard-foundations-layout--overview",
        "url": "?path=/story/standard-foundations-layout--overview"
      },
      "rules": [
        {
          "id": "LAYOUT.HEADINGS",
          "title_zh": "一个 h1，标题有序",
          "statement_zh": "每个页面一个 h1，标题逐级下降；用地标元素、跳转到主内容的链接、原生控件、语义化表格和可见的焦点环，满足 WCAG AA。",
          "rationale_zh": null,
          "surfaces": [
            "admin",
            "public"
          ],
          "enforcement": {
            "kind": "gate",
            "check": "markup.heading-order",
            "check_title_zh": "标题不跳级",
            "active": false
          },
          "params": [],
          "anchors": [
            {
              "spec": "ui",
              "doc": "themes/ui-presentation-and-design.md",
              "quote": "标题层级 h1–h6 与视觉层级一致，不跳过层级"
            }
          ],
          "examples": [],
          "storybook": {
            "id": "standard-foundations-layout--layout-headings",
            "url": "?path=/story/standard-foundations-layout--layout-headings"
          }
        },
        {
          "id": "LAYOUT.REFLOW",
          "title_zh": "先换行，再缩小",
          "statement_zh": "空间不够时先重新排布（换行、换列），不先缩小字号；网格和弹性布局的子项设 min-width 0，避免被长内容撑破；不用 overflow 隐藏把内容藏起来；源码顺序就是阅读顺序。",
          "rationale_zh": null,
          "surfaces": [
            "admin",
            "public"
          ],
          "enforcement": {
            "kind": "review"
          },
          "params": [],
          "anchors": [],
          "examples": [
            {
              "kind": "do",
              "title_zh": "子项 min-w-0，长文本截断",
